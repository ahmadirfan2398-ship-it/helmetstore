<section class="policy-section">
  <div class="container">
    <h2 class="section-title"><%= t.shipping_returns_care %></h2>
    <div class="policy-grid">
      <div class="policy-card">
        <div class="policy-icon"><i class="fa-solid fa-truck-fast"></i></div>
        <h3><%= t.shipping_title %></h3>
        <p><%= t.shipping_desc %></p>
      </div>
      <div class="policy-card">
        <div class="policy-icon"><i class="fa-solid fa-rotate-left"></i></div>
        <h3><%= t.returns_title %></h3>
        <p><%= t.returns_desc %></p>
      </div>
      <div class="policy-card">
        <div class="policy-icon"><i class="fa-solid fa-hand-holding-heart"></i></div>
        <h3><%= t.care_title %></h3>
        <p><%= t.care_desc %></p>
      </div>
    </div>
  </div>
</section>
