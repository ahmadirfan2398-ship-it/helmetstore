<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>

  <main id="mainContent" class="container checkout-page" tabindex="-1">
    <% var crumbs = [{label: t.cart, url: '/cart'}, {label: t.checkout}]; %>
    <%- include('partials/breadcrumb', { crumbs: crumbs }) %>

    <h1><%= t.checkout %></h1>

    <!-- Stepper indicator -->
    <div class="stepper">
      <div class="stepper-step active" data-step="1">
        <div class="stepper-circle">1</div>
        <span><%= t.step_cart %></span>
      </div>
      <div class="stepper-line"></div>
      <div class="stepper-step" data-step="2">
        <div class="stepper-circle">2</div>
        <span><%= t.step_shipping %></span>
      </div>
      <div class="stepper-line"></div>
      <div class="stepper-step" data-step="3">
        <div class="stepper-circle">3</div>
        <span><%= t.step_confirm %></span>
      </div>
    </div>

    <form action="/checkout" method="POST" id="checkoutForm">
      <!-- Step 1: Cart review -->
      <div class="checkout-step active" data-step="1">
        <div class="order-summary">
          <h3><%= t.your_cart %></h3>
          <ul class="summary-list">
            <% cart.forEach(item => { %>
              <li>
                <span><%= lang === 'ur' ? item.name_ur : item.name_en %> x<%= item.qty %></span>
                <span>Rs. <%= (item.price * item.qty).toLocaleString() %></span>
              </li>
            <% }) %>
          </ul>
          <div class="summary-total">
            <strong><%= t.grand_total %>:</strong> <strong>Rs. <%= total.toLocaleString() %></strong>
          </div>
        </div>
        <button type="button" class="btn btn-primary step-next"><%= t.next %> <i class="fa-solid fa-arrow-right"></i></button>
      </div>

      <!-- Step 2: Shipping details -->
      <div class="checkout-step" data-step="2">
        <div class="checkout-form">
          <% if (error) { %><p class="error-msg"><%= error %></p><% } %>

          <label><%= t.full_name %></label>
          <input type="text" name="name" required>

          <label><%= t.phone_number %></label>
          <div class="phone-input-group">
            <select name="countryCode" class="country-code-select">
              <option value="+92" selected>🇵🇰 +92</option>
              <option value="+91">🇮🇳 +91</option>
              <option value="+971">🇦🇪 +971</option>
              <option value="+44">🇬🇧 +44</option>
              <option value="+1">🇺🇸 +1</option>
            </select>
            <input type="tel" name="phone" required placeholder="300 1234567">
          </div>

          <label><%= t.address %></label>
          <textarea name="address" required></textarea>

          <label><%= t.city %></label>
          <input type="text" name="city" required>

          <div class="payment-info">
            <strong><%= t.payment_method %>:</strong> <%= t.cod %>
          </div>
        </div>
        <button type="button" class="btn btn-outline step-back"><i class="fa-solid fa-arrow-left"></i> <%= t.back %></button>
        <button type="button" class="btn btn-primary step-next"><%= t.next %> <i class="fa-solid fa-arrow-right"></i></button>
      </div>

      <!-- Step 3: Confirm -->
      <div class="checkout-step" data-step="3">
        <div class="order-summary">
          <h3><%= t.step_confirm %></h3>
          <ul class="summary-list">
            <% cart.forEach(item => { %>
              <li>
                <span><%= lang === 'ur' ? item.name_ur : item.name_en %> x<%= item.qty %></span>
                <span>Rs. <%= (item.price * item.qty).toLocaleString() %></span>
              </li>
            <% }) %>
          </ul>
          <div class="summary-total">
            <strong><%= t.grand_total %>:</strong> <strong>Rs. <%= total.toLocaleString() %></strong>
          </div>
          <p class="payment-info"><strong><%= t.payment_method %>:</strong> <%= t.cod %></p>
        </div>
        <button type="button" class="btn btn-outline step-back"><i class="fa-solid fa-arrow-left"></i> <%= t.back %></button>
        <button type="submit" class="btn btn-primary" id="placeOrderBtn">
          <span id="placeOrderText"><%= t.place_order %></span>
        </button>
      </div>
    </form>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
